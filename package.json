{
  "name": "guarded-tutor",
  "displayName": "guarded-tutor",
  "description": "AI tutor chat panel for intro programming students",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "guarded-tutor.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "guarded-tutor.setApiKey",
        "title": "Guarded Tutor: Set Gemini API Key"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "guardedTutorSidebar",
          "title": "Guarded Tutor",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "guardedTutorSidebar": [
        {
          "type": "webview",
          "id": "guardedTutor.chatView",
          "name": "Chat",
          "icon": "media/icon.svg"
        }
      ]
    },
    "configuration": {
      "title": "Guarded Tutor",
      "properties": {
        "guardedTutor.provider": {
          "type": "string",
          "default": "gemini",
          "enum": [
            "gemini",
            "openai-compatible"
          ],
          "enumDescriptions": [
            "Google Gemini API (Cloud)",
            "Local or Self-Hosted OpenAI-compatible API (Ollama, vLLM, LM Studio, or NTNU hosted LLM)"
          ],
          "description": "LLM provider to use for the AI tutor."
        },
        "guardedTutor.geminiModel": {
          "type": "string",
          "default": "gemini-3.5-flash-lite",
          "enum": [
            "gemini-3.5-flash-lite",
            "gemini-1.5-flash",
            "gemini-1.5-pro",
            "gemini-2.0-flash"
          ],
          "description": "Gemini model to use when provider is set to Gemini."
        },
        "guardedTutor.customEndpoint": {
          "type": "string",
          "default": "http://localhost:11434/v1",
          "description": "Base URL of the self-hosted/local LLM API (e.g. http://localhost:11434/v1 for Ollama, or an NTNU server URL)."
        },
        "guardedTutor.customModel": {
          "type": "string",
          "default": "llama3.1",
          "description": "Model identifier for the self-hosted/local LLM (e.g. llama3.1, qwen2.5-coder, mistral)."
        },
        "guardedTutor.customApiKey": {
          "type": "string",
          "default": "",
          "description": "Optional API token / Bearer key for the self-hosted endpoint (leave empty if none required)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@highlightjs/cdn-assets": "^11.12.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.134.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "markdown-it": "^15.0.2",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "jszip": "^3.10.2"
  }
}
